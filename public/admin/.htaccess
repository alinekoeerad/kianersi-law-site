# Disable directory browsing
Options -Indexes

# Block direct access to configuration and sensitive data files
<FilesMatch "^(config\.php|config\.json|login_attempts\.json|\.htaccess|.*\.log|.*\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow executing PHP scripts
DirectoryIndex index.php
