# Disable directory browsing
Options -Indexes

# Server Signature Off
ServerSignature Off

# Block direct access to configuration, sensitive data files, and logs
<FilesMatch "(config\.json|config\.php|analytics\.json|login_attempts\.json|.*\.json|.*\.lock|.*\.log|.*\.bak|.*\.env|\.htaccess|\.git)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow executing PHP scripts
DirectoryIndex index.php

# Admin Panel Extra Network Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking completely on admin panel
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Disable sensitive browser caching for admin
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</IfModule>
