# Disable directory browsing
Options -Indexes

# Block direct access to configuration, sensitive data files, and logs
<FilesMatch "(config\.json|config\.php|analytics\.json|login_attempts\.json|.*\.json|.*\.lock|.*\.log|.*\.bak|.*\.env|\.htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow executing PHP scripts
DirectoryIndex index.php
